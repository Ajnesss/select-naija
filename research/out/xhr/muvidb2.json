    "ct": "application/json; charset=utf-8",
    "b": "[{\"id\":\"83d7bef9-ead0-45c2-a73c-dcaf43454ebf\",\"title\":\"Dead Presidents\",\"slug\":\"amit-dead-presidents\",\"poster_url\":\"https://pkenrmorywmuvnzfoylp.supabase.co/storage/v1/object/public/posters/bcba5e97-71dd-4de2-ad61-fc5953913fc4.jpg\",\"backdrop_url\":\"https://pkenrmorywmuvnzfoylp.supabase.co/storage/v1/object/public/backdrops/12ce0a93-c934-4130-b9e0-d73d172b18f1.jpg\",\"year\":2026,\"language\":\"English\",\"genres\":[\"Short\",\"Thriller\",\"Drama\",\"Action\"],\"runtime_minutes\":null,\"view_count\":0,\"average_rating\":0.0,\"liked_percent\":null,\"audience_rating\":null,\"synopsis\":\"It’s the scream of a generation ignored. The daughter of a martyred freedom fighter, forged into a weapon by years of militant training, now points her fury at the heart of the establishment. Her plot to assassinate all 54 African presidents is more than revenge; it’s a desperate, violent tantrum demanding that the old guards finally see the youth they’ve betrayed.\\n\\nDead Presidents is one of six short films in A Moment in Time, an anthology exploring critical societal issues facing young Africans today.\\n\\nCreated and written by Mudzithe Phiri.\",\"tagline\":null,\"tmdb_rating\":null,\"nfvcb_rating\":null,\"countries\":[],\"content_type\":\"short_film\",\"youtube_watch_url\":null,\"release_type\":\"filmporte\",\"streaming_links\":{\"filmporte\": \"https://films.filmporte.com/short-films/amit-dead-presidents\"},\"source\":\"filmporte_sync\",\"is_in_cinemas\":false,\"created_at\":\"2026-10-26T17:52:28.492675+00:00\",\"series_id\":null,\"episode_number\":null,\"season_number\":null,\"episode_count\":null,\"season_count\":null,\"film_genres\":[]}, \n {\"id\":\"2dc32fab-b81b-4752-abfb-a0e3d15845ad\",\"title\":\"Love at First Sight\",\"slug\":\"love-at-first-sight\",\"poster_url\":\"https://pkenrmorywmuvnzfoylp.supabase.co/storage/v1/object/public/posters/ea2778aa-12de-4c8d-8829-43f90059e65c.jpg\",\"backdrop_url\":\"https://pkenrmorywmuvnzfoylp.supabase.co/storage/v1/object/public/backdrops/c5bd1113-ad88-4dd1-afce-f29507c2575a.jpg\",\"year\":2026,\"language\":\"English\",\"genres\":[\"Short\",\"Thriller\",\"Drama\",\"Romance\"],\"runtime_minutes\":null,\"view_count\":0,\"average_rating\":0.0,\"liked_percent\":null,\"audience_rating\":null,\"synopsis\":\"A night of intoxicating connection ends in a cold interrogation room. A wealthy white South African, whose family’s fortune is built on the very land now in dispute, can’t remember what happened to the black woman who beguiled him the night before. As fragments of memory return, he must confront not only a possible murder but the ghosts of a nation’s history and his own complicity.\\n\\nLove at First Sight is one of six short films in A Moment in Time, an anthology exploring critical societal issues facing young Africans today.\\n\\nCreated and written by Mudzithe Phiri.\",\"tagline\":null,\"tmdb_rating\":null,\"nfvcb_rating\":null,\"countries\":[],\"content_type\":\"short_film\",\"youtube_watch_url\":null,\"release_type\":\"filmporte\",\"streaming_links\":{\"filmporte\": \"https://films.filmporte.com/short-films/love-at-first-sight\"},\"source\":\"filmporte_sync\",\"is_in_cinema"
